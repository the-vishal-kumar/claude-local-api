# Copy this file to `.env` (`cp .env.example .env` or `make env`), fill in a
# credential below, then `docker compose up -d`. With Docker, docker-compose
# loads this file automatically (env_file). Every other value shown is the
# built-in default, so a blank/absent variable behaves exactly as below.
#
# Running the bare binary (no Docker)? It does NOT read .env itself — export the
# vars, or use `env $(grep -v '^#' .env | xargs) ./bin/claude-local-api`.

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION — fill in ONE of these (required for tasks to run)
# ─────────────────────────────────────────────────────────────────────────────
# Recommended: a long-lived SUBSCRIPTION token (bills your Claude Pro/Max plan,
# NOT a metered API key). `make token` does this for you: it runs the one-time
# browser authorization and writes the token here automatically. To set it by
# hand instead, run `claude setup-token` and paste the result below.
# CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: a metered Anthropic API key (separate, pay-as-you-go billing).
# To use it you MUST also set CLAUDE_FORCE_SUBSCRIPTION=false below.
# ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# SETTINGS
# ─────────────────────────────────────────────────────────────────────────────

# Address the HTTP server listens on. (Docker overrides this to :8787.)
CLAUDE_API_ADDR=:8787

# Name or path of the Claude Code executable.
CLAUDE_BIN=claude

# Default working directory tasks run in. (Docker overrides this to /workspace.)
CLAUDE_DEFAULT_CWD=.

# Default comma-separated tool allow-list (--allowedTools). Write lets file-
# generation tasks save their output.
CLAUDE_ALLOWED_TOOLS=Read,Edit,Bash,Write

# Default permission mode (--permission-mode).
# One of: default | auto | acceptEdits | plan | dontAsk | bypassPermissions
# acceptEdits is safe for your mounted repo; send permission_mode=bypassPermissions
# per request for unattended file generation (runs in the isolated /runs dir).
CLAUDE_PERMISSION_MODE=acceptEdits

# Extra CLI flags appended to every task (whitespace-separated).
# Example: limit autonomy and pick a model.
# CLAUDE_EXTRA_ARGS=--max-turns 30

# Maximum time a single task may run (Go duration: 90s, 5m, 1h, ...).
CLAUDE_TASK_TIMEOUT=5m

# Maximum JSON request body size in bytes (default 1 MiB). Large file uploads
# should use multipart/form-data, which uses CLAUDE_MAX_UPLOAD_TOTAL_BYTES.
CLAUDE_MAX_BODY_BYTES=1048576

# When true, strip metered API-key vars (ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
# CLAUDE_CODE_API_KEY) from the CLI's environment so tasks bill your subscription;
# the subscription token (CLAUDE_CODE_OAUTH_TOKEN) is preserved. Set to false
# ONLY if you intend to use a metered ANTHROPIC_API_KEY.
CLAUDE_FORCE_SUBSCRIPTION=true

# Emit structured JSON logs instead of human-readable text. Left unset so the
# Docker image's default (JSON) applies; the bare binary defaults to text.
# CLAUDE_JSON_LOGS=true

# --- Workspace / file I/O (uploads, generated-file outputs) ---

# Root for per-request ephemeral working directories. The Docker image sets
# this to /runs (a container-internal volume). Default: a temp subdirectory.
# CLAUDE_WORKSPACE_ROOT=/runs

# When true, file requests without an explicit "cwd" run in a fresh, auto-
# managed (and auto-deleted) workspace. When false, such requests must send cwd.
CLAUDE_WORKSPACE_EPHEMERAL=true

# Keep ephemeral workspaces after the request (for debugging). Default false.
CLAUDE_KEEP_WORKSPACE=false

# Sweep orphaned run-* dirs older than this once at startup (0 disables).
CLAUDE_WORKSPACE_TTL=1h

# Caps for uploaded input files.
CLAUDE_MAX_UPLOAD_BYTES=26214400         # 25 MiB per file
CLAUDE_MAX_UPLOAD_TOTAL_BYTES=104857600  # 100 MiB per multipart request
CLAUDE_MAX_INPUT_FILES=32

# Caps for returned (generated) output files.
CLAUDE_MAX_OUTPUT_BYTES=52428800         # 50 MiB per file
CLAUDE_MAX_OUTPUT_TOTAL_BYTES=209715200  # 200 MiB total
CLAUDE_MAX_OUTPUT_FILES=64
